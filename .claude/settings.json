{
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": ["Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git fetch:*)", "Bash(git switch:*)",
              "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push -u origin:*)", "Bash(node:*)", "Bash(cp:*)",
              "Bash(gcloud:*)", "Bash(bq:*)",
              "mcp__claude-code-remote__list_repos",
              "mcp__claude-code-remote__add_repo", "mcp__claude-code-remote__register_repo_root",
              "Bash(git clone https://github.com/Test-Kokonut/*)",
              "mcp__Google_Drive__*", "mcp__claude_ai_Google_Drive__*",
              "mcp__Gmail__*", "mcp__claude_ai_Gmail__*",
              "mcp__Slack__*", "mcp__claude_ai_Slack__*",
              "mcp__Google_Calendar__*", "mcp__claude_ai_Google_Calendar__*",
              "WebFetch", "WebSearch", "Bash(curl:*)", "Agent"],
    "ask": [],
    "deny": ["mcp__github__push_files", "mcp__github__create_or_update_file", "mcp__github__delete_file"]
  },
  "disableWorkflows": true,
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.js\"", "timeout": 60 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/purpose.js\"", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-main.js\"", "timeout": 10 },
                                                             { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"", "timeout": 20 },
                                                             { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/yes-gate.js\"", "timeout": 10 }] },
                   { "matcher": "mcp__.*|Artifact", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/yes-gate.js\"", "timeout": 10 }] }]
  }
}
