{
  "permissions": {
    "allow": ["Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git fetch:*)", "Bash(git switch:*)",
              "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push -u origin:*)", "Bash(node:*)", "Bash(cp:*)",
              "Bash(gcloud:*)", "Bash(bq:*)",
              "mcp__claude-code-remote__list_repos", "mcp__claude-code-remote__check_repo_access",
              "mcp__claude-code-remote__add_repo", "mcp__claude-code-remote__register_repo_root",
              "Bash(git clone https://github.com/Test-Kokonut/*)",
              "mcp__Google_Drive__*", "mcp__claude_ai_Google_Drive__*",
              "mcp__Gmail__*", "mcp__claude_ai_Gmail__*",
              "mcp__Slack__*", "mcp__claude_ai_Slack__*",
              "mcp__Google_Calendar__*", "mcp__claude_ai_Google_Calendar__*",
              "WebFetch", "WebSearch", "Bash(curl:*)", "Agent", "Task"],
    "ask": ["mcp__Gmail__send_message", "mcp__claude_ai_Gmail__send_message",
            "mcp__Gmail__reply", "mcp__claude_ai_Gmail__reply",
            "mcp__Gmail__forward", "mcp__claude_ai_Gmail__forward",
            "mcp__Gmail__trash_message", "mcp__claude_ai_Gmail__trash_message",
            "mcp__Gmail__trash_thread", "mcp__claude_ai_Gmail__trash_thread",
            "mcp__Gmail__delete_draft", "mcp__claude_ai_Gmail__delete_draft",
            "mcp__Gmail__delete_label", "mcp__claude_ai_Gmail__delete_label",
            "mcp__Gmail__mark_message_spam", "mcp__claude_ai_Gmail__mark_message_spam",
            "mcp__Gmail__mark_thread_spam", "mcp__claude_ai_Gmail__mark_thread_spam",
            "mcp__Google_Drive__trash_file", "mcp__claude_ai_Google_Drive__trash_file",
            "mcp__Google_Drive__share_file", "mcp__claude_ai_Google_Drive__share_file",
            "mcp__Slack__slack_send_message", "mcp__claude_ai_Slack__slack_send_message",
            "mcp__Slack__slack_schedule_message", "mcp__claude_ai_Slack__slack_schedule_message",
            "mcp__Slack__slack_send_message_draft", "mcp__claude_ai_Slack__slack_send_message_draft",
            "mcp__Slack__slack_create_conversation", "mcp__claude_ai_Slack__slack_create_conversation",
            "mcp__claude_ai_Upwork", "mcp__Upwork",
            "Workflow", "Artifact",
            "Bash(git branch -D:*)", "Bash(git branch -d:*)", "Bash(git push --delete:*)", "Bash(git push -d:*)",
            "Bash(git push origin --delete:*)", "Bash(git push origin -d:*)", "Bash(rm -r:*)", "Bash(rm -rf:*)",
            "PowerShell(Remove-Item:*)", "PowerShell(git branch -D:*)",
            "Bash(gcloud run deploy:*)", "Bash(gcloud run services update:*)", "Bash(gcloud run services delete:*)",
            "Bash(gcloud run jobs execute:*)", "Bash(gcloud builds submit:*)", "Bash(gcloud builds triggers run:*)",
            "Bash(gcloud sql:*)", "Bash(gcloud secrets:*)", "Bash(gcloud iam:*)", "Bash(gcloud projects:*)",
            "Bash(gcloud scheduler jobs run:*)", "Bash(gcloud scheduler jobs delete:*)", "Bash(gcloud scheduler jobs pause:*)",
            "Bash(bq rm:*)", "Bash(bq load:*)", "Bash(bq mk:*)", "Bash(bq update:*)"],
    "deny": ["mcp__github__push_files", "mcp__github__create_or_update_file", "mcp__github__delete_file"]
  },
  "disableWorkflows": true,
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.js\"", "timeout": 60 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reminder.js\"", "timeout": 10 },
                                     { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/status-check.js\"", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-main.js\"", "timeout": 10 },
                                                             { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"", "timeout": 20 },
                                                             { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-guard.js\"", "timeout": 30 }] },
                   { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-guard.js\"", "timeout": 30 }] }]
  }
}
